#: ../../../reference/examples.rst:3
msgid "Examples"
msgstr ""

#: ../../../reference/examples.rst:5
msgid ""
"Copy-paste command examples. For every flag see the :doc:`CLI reference "
"<cli>`. For step-by-step narratives, follow the how-to guides linked in each "
"section."
msgstr ""

#: ../../../reference/examples.rst:10
msgid "install"
msgstr ""

#: ../../../reference/examples.rst:12
msgid "Install from PyPI, optionally pinning the Python version:"
msgstr ""

#: ../../../reference/examples.rst:14
msgid ""
"pipx install pycowsay\n"
"pipx install --python 3.12 pycowsay\n"
"pipx install --fetch-python=missing --python 3.12 pycowsay"
msgstr ""

#: ../../../reference/examples.rst:20
msgid "Constrain or eagerly upgrade a version spec:"
msgstr ""

#: ../../../reference/examples.rst:22
msgid ""
"pipx install --upgrade 'black>=22,<23'\n"
"pipx install --upgrade --upgrade-strategy eager 'black>=22,<23'"
msgstr ""

#: ../../../reference/examples.rst:27
msgid ""
"Install extras, include dependency apps, or preinstall build-time packages:"
msgstr ""

#: ../../../reference/examples.rst:29
msgid ""
"pipx install 'black[d]'\n"
"pipx install --include-deps jupyter\n"
"pipx install --preinstall ansible-lint --preinstall mitogen ansible-core"
msgstr ""

#: ../../../reference/examples.rst:35
msgid "Install from a VCS URL, an archive, or a local project:"
msgstr ""

#: ../../../reference/examples.rst:37
msgid ""
"pipx install git+https://github.com/psf/black\n"
"pipx install git+https://github.com/psf/black.git@branch-name\n"
"pipx install https://github.com/psf/black/archive/18.9b0.zip\n"
"pipx install ./path/to/some-project"
msgstr ""

#: ../../../reference/examples.rst:44
msgid "Install from a PEP 723 script or a lock file:"
msgstr ""

#: ../../../reference/examples.rst:46
msgid ""
"pipx install ./script.py\n"
"pipx install --lock pylock.toml ."
msgstr ""

#: ../../../reference/examples.rst:51
msgid ""
"For a local script, the filename without its extension supplies the command "
"name. Pass ``--app`` to choose a different name:"
msgstr ""

#: ../../../reference/examples.rst:54
msgid "pipx install --app greet ./script.py"
msgstr ""

#: ../../../reference/examples.rst:58
msgid "Pass arguments through to pip, or install globally for all users:"
msgstr ""

#: ../../../reference/examples.rst:60
msgid ""
"pipx install --pip-args='--pre' poetry\n"
"pipx install --global pycowsay"
msgstr ""

#: ../../../reference/examples.rst:67
msgid "run"
msgstr ""

#: ../../../reference/examples.rst:69
msgid ""
"Run an app in a temporary environment, optionally pinning package or Python "
"version:"
msgstr ""

#: ../../../reference/examples.rst:71
msgid ""
"pipx run pycowsay moo\n"
"pipx run --spec 'pycowsay==2.0' pycowsay --version\n"
"pipx run --python 3.12 pycowsay moo"
msgstr ""

#: ../../../reference/examples.rst:77
msgid "Run from a VCS URL or an archive:"
msgstr ""

#: ../../../reference/examples.rst:79
msgid ""
"pipx run git+https://github.com/psf/black.git\n"
"pipx run --spec https://github.com/psf/black/archive/18.9b0.zip black --help"
msgstr ""

#: ../../../reference/examples.rst:84
msgid "Run a local or remote script, with arguments:"
msgstr ""

#: ../../../reference/examples.rst:86
msgid ""
"pipx run test.py 1 2 3\n"
"pipx run https://example.com/test.py 1 2 3"
msgstr ""

#: ../../../reference/examples.rst:91
msgid ""
"A bare filename is ambiguous: pipx runs it as a local file when the file "
"exists, otherwise as a PyPI package. Force the interpretation with ``--"
"path`` or ``--spec``:"
msgstr ""

#: ../../../reference/examples.rst:94
msgid ""
"pipx run --path test.py         # always a local file\n"
"pipx run --spec test-py test.py # always a PyPI package"
msgstr ""

#: ../../../reference/examples.rst:99
msgid ""
"Scripts can declare dependencies with PEP 723 inline metadata; pipx installs "
"them into the temporary environment. See :doc:`Run scripts <../how-to/run-"
"scripts>`."
msgstr ""

#: ../../../reference/examples.rst:104
msgid "inject"
msgstr ""

#: ../../../reference/examples.rst:106
msgid ""
"Add packages to an existing environment, from the command line or a "
"requirements file:"
msgstr ""

#: ../../../reference/examples.rst:108
msgid ""
"pipx inject ptpython requests pendulum\n"
"pipx inject ptpython --requirement useful-packages.txt"
msgstr ""

#: ../../../reference/examples.rst:113
msgid "The two forms can be combined and repeated:"
msgstr ""

#: ../../../reference/examples.rst:115
msgid "pipx inject ptpython package-1 package-2 -r extra-1.txt -r extra-2.txt"
msgstr ""

#: ../../../reference/examples.rst:119
msgid ""
"See :doc:`Inject packages <../how-to/inject-packages>` for the requirements-"
"file format and the ``--include-apps`` option."
msgstr ""

#: ../../../reference/examples.rst:124
msgid "list"
msgstr ""

#: ../../../reference/examples.rst:126
msgid "List installed packages and their apps:"
msgstr ""

#: ../../../reference/examples.rst:128
msgid ""
"$ pipx list\n"
"venvs are in /home/user/.local/share/pipx/venvs\n"
"apps are exposed on your $PATH at /home/user/.local/bin\n"
"   package black 24.3.0, Python 3.12.0\n"
"    - black\n"
"    - blackd\n"
"   package pipx 1.4.3, Python 3.12.0\n"
"    - pipx"
msgstr ""

#: ../../../reference/examples.rst:139
msgid ""
"Narrow the output or change the format; the package filter works with every "
"format:"
msgstr ""

#: ../../../reference/examples.rst:141
msgid ""
"pipx list --short\n"
"pipx list black pipx --short\n"
"pipx list black --outdated\n"
"pipx list --output json > pipx.json"
msgstr ""

#: ../../../reference/examples.rst:150
msgid "install-all"
msgstr ""

#: ../../../reference/examples.rst:152
msgid ""
"Reinstall from a snapshot produced by ``pipx list --output json`` (see :doc:"
"`json-output`):"
msgstr ""

#: ../../../reference/examples.rst:154
msgid ""
"$ pipx install-all pipx.json\n"
"'black' already seems to be installed. Not modifying existing installation "
"in '/usr/local/pipx/venvs/black'. Pass '--force' to force installation.\n"
"'pipx' already seems to be installed. Not modifying existing installation in "
"'/usr/local/pipx/venvs/pipx'. Pass '--force' to force installation.\n"
"$ pipx install-all pipx.json --force\n"
"Installing to existing venv 'black'\n"
"  installed package black 24.3.0, installed using Python 3.12.0\n"
"  These apps are now globally available\n"
"    - black\n"
"    - blackd\n"
"Installing to existing venv 'pipx'\n"
"  installed package pipx 1.4.3, installed using Python 3.12.0\n"
"  These apps are now globally available\n"
"    - pipx"
msgstr ""

#: ../../../reference/examples.rst:172
msgid "upgrade-shared"
msgstr ""

#: ../../../reference/examples.rst:174
msgid ""
"Upgrade the shared libraries, or pin pip to a specific version until the "
"next automatic upgrade:"
msgstr ""

#: ../../../reference/examples.rst:176
msgid ""
"pipx upgrade-shared\n"
"pipx upgrade-shared --pip-args=pip==24.0"
msgstr ""

#: ../../../reference/examples.rst:183
msgid "pin"
msgstr ""

#: ../../../reference/examples.rst:185
msgid ""
"Pin an environment so its packages are held at their current versions until "
"you unpin. See :doc:`Pin packages <../how-to/pin-packages>`."
msgstr ""

#: ../../../reference/examples.rst:188
msgid "Pin only injected packages, leaving the main package upgradable:"
msgstr ""

#: ../../../reference/examples.rst:190
msgid ""
"$ pipx pin poetry --injected-only\n"
"Pinned 2 packages in venv poetry\n"
"  - poetry-plugin-export <current version>\n"
"  - poetry-plugin-app <current version>"
msgstr ""

#: ../../../reference/examples.rst:197
msgid "Unpin the whole environment so upgrades resume:"
msgstr ""

#: ../../../reference/examples.rst:199
msgid ""
"$ pipx unpin poetry\n"
"Unpinned 3 packages in venv poetry\n"
"  - poetry\n"
"  - poetry-plugin-export\n"
"  - poetry-plugin-app"
msgstr ""
