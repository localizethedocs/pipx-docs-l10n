#: ../../../how-to/move-installation.rst:3
msgid "Move installation"
msgstr "移動安裝"

#: ../../../how-to/move-installation.rst:5
msgid ""
"Relocate your pipx directory to a new location and rebuild the environments "
"there."
msgstr ""

#: ../../../how-to/move-installation.rst:7
msgid ""
"The snippets below move from a non-default location to the current default. "
"To move somewhere else, replace the ``NEW_LOCATION`` value. For which paths "
"pipx defaults to and why they moved, see :ref:`platformdirs-migration`."
msgstr ""

#: ../../../how-to/move-installation.rst:12
msgid ""
"These snippets delete the cache, log, and trash directories (pipx recreates "
"them) and move ``PIPX_HOME``. Run ``pipx reinstall-all`` afterward so every "
"environment rebuilds at the new location."
msgstr ""

#: ../../../how-to/move-installation.rst:17
msgid "macOS"
msgstr "macOS"

#: ../../../how-to/move-installation.rst:19
msgid "Current default location: ``~/Library/Application Support/pipx``."
msgstr "當前默認位置：``~/Library/Application Support/pipx``。"

#: ../../../how-to/move-installation.rst:21
msgid ""
"cache_dir=$(pipx environment --value PIPX_VENV_CACHEDIR)\n"
"logs_dir=$(pipx environment --value PIPX_LOG_DIR)\n"
"trash_dir=$(pipx environment --value PIPX_TRASH_DIR)\n"
"home_dir=$(pipx environment --value PIPX_HOME)\n"
"NEW_LOCATION='~/Library/Application Support/pipx'\n"
"rm -rf \"$cache_dir\" \"$logs_dir\" \"$trash_dir\"\n"
"mkdir -p \"$NEW_LOCATION\" && mv \"$home_dir\" \"$NEW_LOCATION\"\n"
"pipx reinstall-all"
msgstr ""
"cache_dir=$(pipx environment --value PIPX_VENV_CACHEDIR)\n"
"logs_dir=$(pipx environment --value PIPX_LOG_DIR)\n"
"trash_dir=$(pipx environment --value PIPX_TRASH_DIR)\n"
"home_dir=$(pipx environment --value PIPX_HOME)\n"
"NEW_LOCATION='~/Library/Application Support/pipx'\n"
"rm -rf \"$cache_dir\" \"$logs_dir\" \"$trash_dir\"\n"
"mkdir -p \"$NEW_LOCATION\" && mv \"$home_dir\" \"$NEW_LOCATION\"\n"
"pipx reinstall-all"

#: ../../../how-to/move-installation.rst:34
msgid "Linux"
msgstr "Linux"

#: ../../../how-to/move-installation.rst:36
msgid "Current default location: ``~/.local/share``."
msgstr "當前默認位置：``~/.local/share``。"

#: ../../../how-to/move-installation.rst:38
msgid ""
"cache_dir=$(pipx environment --value PIPX_VENV_CACHEDIR)\n"
"logs_dir=$(pipx environment --value PIPX_LOG_DIR)\n"
"trash_dir=$(pipx environment --value PIPX_TRASH_DIR)\n"
"home_dir=$(pipx environment --value PIPX_HOME)\n"
"NEW_LOCATION=\"${XDG_DATA_HOME:-$HOME/.local/share}\"\n"
"rm -rf \"$cache_dir\" \"$logs_dir\" \"$trash_dir\"\n"
"mkdir -p \"$NEW_LOCATION\" && mv \"$home_dir\" \"$NEW_LOCATION\"\n"
"pipx reinstall-all"
msgstr ""
"cache_dir=$(pipx environment --value PIPX_VENV_CACHEDIR)\n"
"logs_dir=$(pipx environment --value PIPX_LOG_DIR)\n"
"trash_dir=$(pipx environment --value PIPX_TRASH_DIR)\n"
"home_dir=$(pipx environment --value PIPX_HOME)\n"
"NEW_LOCATION=\"${XDG_DATA_HOME:-$HOME/.local/share}\"\n"
"rm -rf \"$cache_dir\" \"$logs_dir\" \"$trash_dir\"\n"
"mkdir -p \"$NEW_LOCATION\" && mv \"$home_dir\" \"$NEW_LOCATION\"\n"
"pipx reinstall-all"

#: ../../../how-to/move-installation.rst:51
msgid "Windows"
msgstr "Windows"

#: ../../../how-to/move-installation.rst:53
msgid "Current default location: ``~/pipx``."
msgstr "當前默認位置：``~/pipx``。"

#: ../../../how-to/move-installation.rst:55
msgid ""
"$NEW_LOCATION = Join-Path \"$HOME\" 'pipx'\n"
"$cache_dir = pipx environment --value PIPX_VENV_CACHEDIR\n"
"$logs_dir = pipx environment --value PIPX_LOG_DIR\n"
"$trash_dir = pipx environment --value PIPX_TRASH_DIR\n"
"$home_dir = pipx environment --value PIPX_HOME\n"
"\n"
"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$cache_dir\", "
"\"$logs_dir\", \"$trash_dir\"\n"
"\n"
"# Remove the destination first so Move-Item renames rather than nests\n"
"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$NEW_LOCATION\"\n"
"\n"
"Move-Item -Path $home_dir -Destination \"$NEW_LOCATION\"\n"
"pipx reinstall-all"
msgstr ""

#: ../../../how-to/move-installation.rst:71
msgid ""
"To move it from git-bash or WSL instead, follow the macOS/Linux steps and "
"set ``NEW_LOCATION`` to the Windows path."
msgstr ""

#: ../../../how-to/move-installation.rst:75
msgid "Verify it"
msgstr ""

#: ../../../how-to/move-installation.rst:77
msgid ""
"$ pipx environment --value PIPX_HOME\n"
"$ pipx list"
msgstr ""
"$ pipx environment --value PIPX_HOME\n"
"$ pipx list"

#: ../../../how-to/move-installation.rst:82
msgid ""
"The home path reflects the new location and every environment lists cleanly "
"after the reinstall."
msgstr ""
