#: ../../../reference/examples.rst:226
msgid "pin"
msgstr ""

#: ../../../reference/examples.rst:228
msgid ""
"Pin an environment so pipx holds its packages at their current versions "
"until you unpin. See :doc:`Pin packages <../how-to/pin-packages>`."
msgstr ""

#: ../../../reference/examples.rst:231
msgid "Pin only injected packages, leaving the main package upgradable:"
msgstr ""

#: ../../../reference/examples.rst:233
msgid ""
"$ pipx pin poetry --injected-only\n"
"pipx pinned 2 packages in venv poetry\n"
"  - poetry-plugin-export <current version>\n"
"  - poetry-plugin-app <current version>"
msgstr ""

#: ../../../reference/examples.rst:240
msgid ""
"Unpin the environment so upgrades resume. The output lists only the packages "
"that were pinned:"
msgstr ""

#: ../../../reference/examples.rst:242
msgid ""
"$ pipx unpin poetry\n"
"pipx unpinned 2 packages in venv poetry\n"
"  - poetry-plugin-export\n"
"  - poetry-plugin-app"
msgstr ""
