"Directory holding the per-package virtual environments (``$PIPX_HOME/"
"venvs``)."
msgstr ""

#: ../../../reference/environment-variables.rst:116
msgid "``PIPX_LOG_DIR``"
msgstr ""

#: ../../../reference/environment-variables.rst:117
msgid "Directory holding command logs."
msgstr ""

#: ../../../reference/environment-variables.rst:118
msgid "``PIPX_TRASH_DIR``"
msgstr ""

#: ../../../reference/environment-variables.rst:119
msgid "Staging directory for deletions on the same filesystem as the venvs."
msgstr ""

#: ../../../reference/environment-variables.rst:120
msgid "``PIPX_VENV_CACHEDIR``"
msgstr ""

#: ../../../reference/environment-variables.rst:121
msgid "Cache directory for ``pipx run`` environments."
msgstr ""

#: ../../../reference/environment-variables.rst:122
msgid "``PIPX_STANDALONE_PYTHON_CACHEDIR``"
msgstr ""

#: ../../../reference/environment-variables.rst:123
msgid "Cache directory for downloaded standalone Python builds."
msgstr ""

#: ../../../reference/environment-variables.rst:124
msgid "``PIPX_RESOLVED_BACKEND``"
msgstr ""

#: ../../../reference/environment-variables.rst:125
msgid "Backend pipx resolved for new venvs (``pip`` or ``uv``)."
msgstr ""

#: ../../../reference/environment-variables.rst:126
msgid "``PIPX_BACKEND_SOURCE``"
msgstr ""

#: ../../../reference/environment-variables.rst:127
msgid ""
"Where the resolved backend came from: ``env``, ``auto-bundled``, ``auto-"
"path``, or ``auto-pip``."
msgstr ""

#: ../../../reference/environment-variables.rst:128
msgid "``PIPX_UV_BINARY``"
msgstr ""

#: ../../../reference/environment-variables.rst:129
msgid "Path to the ``uv`` binary pipx would use, or empty when it finds none."
msgstr ""

#: ../../../reference/environment-variables.rst:130
msgid "``UV_CACHE_DIR``"
msgstr ""

#: ../../../reference/environment-variables.rst:131
msgid "Value of ``UV_CACHE_DIR`` in the environment, passed through to ``uv``."
msgstr ""
