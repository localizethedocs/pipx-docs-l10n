#: ../../../contributing.rst:260
msgid "Building Documentation"
msgstr ""

#: ../../../contributing.rst:262
msgid ""
"The documentation is built with Sphinx. When updating pipx docs, make sure "
"you are modifying the ``docs`` directory."
msgstr ""

#: ../../../contributing.rst:264
msgid "Build the HTML documentation with"
msgstr ""

#: ../../../contributing.rst:266
msgid "$ tox run -e docs"
msgstr ""

