#: ../../../contributing.rst:174
msgid "Unit Tests"
msgstr ""

#: ../../../contributing.rst:176
msgid "To run unit tests in Python 3.12, you can run"
msgstr ""

#: ../../../contributing.rst:178
msgid "$ tox run -e 3.12"
msgstr ""

